# ScriptStack Server Configuration
# 复制本文件为 .env 并填入实际值

# ── 服务 ──
SCRIPTSTACK_LISTEN_ADDR=127.0.0.1:3000
SCRIPTSTACK_JWT_SECRET=your-super-secret-key-change-me-in-production
SCRIPTSTACK_JWT_EXPIRE_HOURS=72
SCRIPTSTACK_UPLOAD_DIR=./data/uploads
SCRIPTSTACK_MAX_UPLOAD_MB=50

# ── 初始管理员账号 ──
# 首次启动时会自动写入/更新管理员；生产环境必须改成强密码。
SCRIPTSTACK_ADMIN_USERNAME=admin
SCRIPTSTACK_ADMIN_PASSWORD=change-this-admin-password
SCRIPTSTACK_ADMIN_EMAIL=admin@example.com

# ── LLM 文字模型 ──
SCRIPTSTACK_LLM_TEXT_ENDPOINT=https://api.deepseek.com
SCRIPTSTACK_LLM_TEXT_KEY=sk-your-key-here
SCRIPTSTACK_LLM_TEXT_MODEL=deepseek-chat
SCRIPTSTACK_LLM_TEXT_MODE=openai

# ── LLM 图片模型 ──
SCRIPTSTACK_LLM_IMAGE_ENDPOINT=
SCRIPTSTACK_LLM_IMAGE_KEY=
SCRIPTSTACK_LLM_IMAGE_MODEL=

# ── 数据库 ──
SCRIPTSTACK_DB_PATH=./data/scriptstack.db

# ── 质量阈值 ──
SCRIPTSTACK_REVIEW_THRESHOLD=70
